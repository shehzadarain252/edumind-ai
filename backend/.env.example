# Copy this file to .env and fill in your own values.
# NEVER commit .env — it contains your private Gemini API key.
# Get a free key at Google AI Studio: https://aistudio.google.com/app/apikey

# Gemini API key (required for AI answers). Keep it secret.
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model (optional — defaults to gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash

# Port the backend listens on (optional — defaults to 3000).
PORT=3000
